{
  "name": "rollup-plugin-lib-style",
  "version": "2.4.2",
  "description": "A Rollup plugin that converts CSS and extensions for CSS into CSS modules and imports the generated CSS files",
  "main": "lib/index.js",
  "module": "lib/index.es.js",
  "files": [
    "lib",
    "types/index.d.ts"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "build:esm": "rollup --input src/index.js --file lib/index.es.js --format es --config",
    "build:cjs": "rollup --input src/index.js --file lib/index.js --format cjs --config",
    "prepublishOnly": "npm run build && npm run test",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "lint:fix": "eslint **/*.{js,jsx} --fix",
    "lint": "eslint **/*.{js,jsx}",
    "test": "true || jest",
    "test:cov": "true || jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielamenou/rollup-plugin-lib-style"
  },
  "keywords": [
    "library",
    "rollup",
    "plugin",
    "style",
    "sass",
    "scss",
    "css"
  ],
  "author": "Daniel Amenou <amenou.daniel@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=16"
  },
  "types": "./types/index.d.ts",
  "devDependencies": {
    "@babel/core": "^7.20.5",
    "@babel/eslint-parser": "^7.19.1",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@types/jest": "^29.2.3",
    "babel-core": "^6.26.3",
    "babel-jest": "^29.3.1",
    "eslint": "^8.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-rem": "^4.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.3.1",
    "jest-environment-node-single-context": "^29.0.0",
    "prettier": "^2.8.0",
    "rollup": "^3.5.0"
  },
  "dependencies": {
    "fs-extra": "^11.1.0",
    "glob": "7.2.3",
    "postcss": "8.4.39",
    "postcss-modules": "4.0.0",
    "rollup-pluginutils": "2.8.2",
    "sass": "1.55.0"
  }
}
